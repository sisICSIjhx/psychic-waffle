# Copiar como .env y llenar con los valores reales (el .env no se versiona).

# Supabase (proyecto pendiente de crear; tarea 3.8)
PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: nunca exponer en el navegador
SUPABASE_SERVICE_ROLE_KEY=

# Conversión de prueba a PDF (opcional). Ejemplo en Windows:
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=

# Almacenamiento local de fotografías y documentos generados (ignorado por Git)
STORAGE_DIR=./storage
