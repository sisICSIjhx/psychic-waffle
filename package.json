{
	"name": "reportes-icsi",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"graph": "codegraph",
		"graph:status": "codegraph status",
		"graph:sync": "codegraph sync",
		"spec": "openspec",
		"spec:check": "openspec validate --all --strict",
		"spec:list": "openspec list --specs",
		"plantilla:construir": "node scripts/construir-plantilla.ts",
		"prueba:documental": "node scripts/prueba-documental.ts",
		"verificar:datos": "node scripts/verificar-datos-personales.ts"
	},
	"devDependencies": {
		"@colbymchenry/codegraph": "1.6.2",
		"@electric-sql/pglite": "0.5.10",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@fission-ai/openspec": "1.14.2",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.0.10",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.0",
		"globals": "^16.5.0",
		"playwright": "^1.56.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"vite": "^7.2.2",
		"vitest": "^4.0.10",
		"vitest-browser-svelte": "^2.0.1"
	},
	"dependencies": {
		"@supabase/supabase-js": "2.118.0",
		"docx-templates": "4.15.0",
		"jszip": "3.10.2",
		"sharp": "0.35.5",
		"zod": "4.6.7"
	}
}
